# 后端服务配置
ACG_API_ADDR=127.0.0.1:8787
ACG_DATA_DIR=/opt/acg-api/data
ACG_ALLOWED_ORIGINS=https://hoarfrost.cloud,https://www.hoarfrost.cloud,http://localhost:5173,http://127.0.0.1:5173

# 邮箱登录（站长邮箱不可注册）
AUTH_OWNER_PASSWORD=your_strong_password_min_8_chars
AUTH_OWNER_SECURITY_ANSWER=your_student_id_answer
AUTH_SESSION_DAYS=30
# 生产环境 HTTPS 设 true
AUTH_COOKIE_SECURE=true

# 腾讯云 COS（随笔图片上传）
TENCENT_COS_SECRET_ID=your_tencent_cos_secret_id
TENCENT_COS_SECRET_KEY=your_tencent_cos_secret_key
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_BUCKET=my-blog-static-1464122491
TENCENT_COS_BASE_URL=https://my-blog-static-1464122491.cos.ap-guangzhou.myqcloud.com
