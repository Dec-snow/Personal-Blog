# Copy to /etc/hoarfrost/ai-healthcheck.env on the UCloud server.
# Do not commit the real cookie.

HOARFROST_AI_ENDPOINT=https://hoarfrost.cloud/api/chat
HOARFROST_AI_MESSAGE=请回复 OK，并说明当前服务正常
HOARFROST_AI_COOKIE=
HOARFROST_AI_COUNT=20
HOARFROST_AI_START=08:00
HOARFROST_AI_END=23:30
HOARFROST_AI_TIMEOUT=20
HOARFROST_AI_LOG=/var/log/hoarfrost-ai-healthcheck.log
